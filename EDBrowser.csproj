<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ED.Browser.4.4.1.Portable</AssemblyName>
    <RootNamespace>EDBrowser</RootNamespace>
    <Product>ED Browser</Product>
    <AssemblyTitle>ED Browser</AssemblyTitle>
    <Company>Erol Dizdar</Company>
    <Authors>Erol Dizdar</Authors>
    <Description>ED Browser v4 - Ultra hafif WebView2 tabanlı masaüstü web tarayıcısı</Description>
    <Version>4.4.1</Version>
    <FileVersion>4.4.1.0</FileVersion>
    <AssemblyVersion>4.4.1.0</AssemblyVersion>
    <ApplicationIcon>Assets\edbrowser.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <NoWarn>MSB3277;CS8602;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\edbrowser.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Installer\**" />
    <EmbeddedResource Remove="Installer\**" />
    <None Remove="Installer\**" />
  </ItemGroup>

</Project>
